# StockVision AI Environment Configuration

# General FastAPI Configuration
ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173", "http://127.0.0.1:5173"]

# Database Setup
# Use aiosqlite locally: sqlite+aiosqlite:///./stockvision.db
# Use Postgres in Docker: postgresql+asyncpg://postgres:postgres@db:5432/stockvision
DATABASE_URL=sqlite+aiosqlite:///./stockvision.db

# API Keys (Add your keys here if using external news sources, standard defaults provided)
NEWS_API_KEY=
FINNHUB_API_KEY=

# ML Models Settings
LOOKBACK_STEPS=60
FORECAST_HORIZON=1
MODEL_CHECKPOINT_DIR=./checkpoints

# Redis Connection (Optional for caching, defaults to in-memory if unavailable)
REDIS_URL=redis://localhost:6379/0
